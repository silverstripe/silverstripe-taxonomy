{
    "name": "silverstripe/taxonomy",
    "description": "Provide extra taxonomy for cataloguing the data.",
    "type": "silverstripe-vendormodule",
    "keywords": [
        "silverstripe",
        "cwp"
    ],
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Robert Curry",
            "email": "robert@silverstripe.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "silverstripe/framework": "^6",
        "silverstripe/admin": "^3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.3",
        "squizlabs/php_codesniffer": "^3",
        "silverstripe/standards": "^1",
        "phpstan/extension-installer": "^1.3",
        "silverstripe/documentation-lint": "^2",
        "silverstripe/testsession": "^4"
    },
    "autoload": {
        "psr-4": {
            "SilverStripe\\Taxonomy\\": "src/",
            "SilverStripe\\Taxonomy\\Tests\\": "tests/"
        }
    },
    "extra": {
        "expose": [
            "client/dist",
            "client/lang"
        ]
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
